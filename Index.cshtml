@{
    ViewData["Title"] = "Home Page";
}

<div style="display:flex; align-items:center; justify-content:space-between; background:white; padding:40px; border-radius:20px; box-shadow: 0 0 20px rgba(0,0,0,0.1);">
    <div style="max-width:50%;">
        <h2 style="color:#0066cc;">CHÀO MỪNG ĐẾN VỚI MAGNUS</h2>
        <p>Sự hài lòng của bạn là chất lượng của chúng tôi.</p>
        <div style="margin-top:20px;">
            <a href="/account/login" class="btn btn-outline-primary">Đăng nhập</a>
            <a href="/account/register" class="btn btn-primary" style="margin-left:10px;">Đăng ký</a>
        </div>
    </div>
    <div>
        @* <img src="~/images/laptop.png" alt="Laptop" style="width:400px;" /> *@
        <img src="~/images/magnus-logo.png" alt="MAGNUS" style="height:40px; margin-right:10px;" />
    </div>
</div>

<!-- Carousel dots -->
<div style="text-align:center; margin-top:60px;">
    <span style="height:12px; width:12px; background-color:#007bff; border-radius:50%; display:inline-block;"></span>
    <span style="height:12px; width:12px; background-color:lightgray; border-radius:50%; display:inline-block; margin-left:5px;"></span>
    <span style="height:12px; width:12px; background-color:lightgray; border-radius:50%; display:inline-block; margin-left:5px;"></span>
    <span style="height:12px; width:12px; background-color:lightgray; border-radius:50%; display:inline-block; margin-left:5px;"></span>
</div>