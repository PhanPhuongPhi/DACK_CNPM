@{
}
@model WebApp.Models.RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<h2>Đăng ký tài khoản</h2>

<form asp-action="Register" method="post">
    <div>
        <label asp-for="Username"></label>
        <input asp-for="Username" />
        <span asp-validation-for="Username"></span>
    </div>
    <div>
        <label asp-for="RealName">Tên thật</label>
        <input asp-for="RealName" />
        <span asp-validation-for="RealName"></span>
    </div>
    <div>
        <label asp-for="PhoneNumber">Số điện thoại</label>
        <input asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber"></span>
    </div>
    <div>
        <label asp-for="DateOfBirth">Ngày sinh</label>
        <input asp-for="DateOfBirth" type="date" />
        <span asp-validation-for="DateOfBirth"></span>
    </div>
    <div>
        <label asp-for="Password">Mật khẩu</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <div>
        <label asp-for="Role">Loại tài khoản</label>
        <select asp-for="Role">
            <option value="customer">Khách hàng</option>
            <option value="employee">Nhân viên</option>
            <option value="admin">Admin</option>
        </select>
    </div>
    <button type="submit">Đăng ký</button>
</form>

<p>Hoặc đăng ký bằng:</p>
<button>Google</button>
<button>Zalo</button>

<a href="/Account/Login">Đã có tài khoản? Đăng nhập</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}