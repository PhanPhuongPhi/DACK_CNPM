<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MAGNUS</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
</head>
<body style="background-color: #cce5ff;">
    <div class="container">
        <header style="background-color:white; padding: 20px; border-radius: 20px; box-shadow: 0 0 20px rgba(0,0,0,0.1); max-width: 1600px; margin: auto;">
            <div style="display:flex; flex-direction: column;">
                <!-- Dòng 1 -->
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <!-- Logo -->
                    <div style="display:flex; align-items:center; width:250px;">
                        <img src="~/images/magnus-logo.png" alt="MAGNUS" style="height:40px; margin-right:10px;" />
                        <strong style="font-size:24px;">MAGNUS</strong>
                    </div>

                    <!-- Menu dòng 1 -->
                    <div id="top-menu" style="display:flex; gap: 30px; flex: 1;">
                        <a href="/" class="nav-link">Về trang chủ</a>
                        <a href="/about-us" class="nav-link">Về chúng tôi</a>
                    </div>

                    <!-- Search + Cart -->
                    <div style="display:flex; align-items:center; gap: 15px;">
                        <input type="text" placeholder="Search" style="padding:6px 14px; width:350px; border-radius:20px; border:1px solid #ccc;" />
                        <a href="/cart" style="color: black;"><i class="fas fa-shopping-cart"></i><span>(0)</span></a>
                    </div>
                </div>

                <!-- Dòng 2: Menu sản phẩm -->
                <div style="margin-top: 12px; display: flex; gap: 30px; padding-left: 250px;">
                    <a href="/products/laptops" class="nav-link">Laptops và desktops</a>
                    <a href="/products/phones" class="nav-link">Điện thoại</a>
                    <a href="/products/headsets" class="nav-link">Tai nghe và headset</a>
                    <a href="/products/mouse" class="nav-link">Chuột</a>
                </div>
            </div>
        </header>

        <main role="main" style="margin-top:40px;">
            @RenderBody()
        </main>
    </div>

    <footer>
        @RenderSection("Scripts", required: false)
    </footer>
</body>
</html>
